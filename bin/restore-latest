#!/bin/sh
set -eu

. /usr/local/lib/mysql-cluster/common.sh

drop_privileges "$0" "$@"

newest_first() {
    sort -r
}

archive_is_valid() {
    expected=$(s3_expected_sha256 "$1")
    if [ -n "$expected" ] && [ "$(sha256_of "$2")" != "$expected" ]; then
        log "$1 checksum mismatch"
        return 1
    fi
    zstd -q -t "$2" || { log "$1 is not a valid zstd archive"; return 1; }
}

prepare_backup() {
    staging="$workdir/staging"
    rm -rf "$staging"
    mkdir -p "$staging"
    zstd -q -dc "$1" | xbstream -x -C "$staging" || { log "could not unpack $2"; return 1; }
    xtrabackup --prepare --use-memory=256M --target-dir="$staging" > "$workdir/prepare.log" 2>&1 \
        || { log "$2 could not be prepared: $(tail -n 3 "$workdir/prepare.log" | tr '\n' ' ')"; return 1; }
}

empty_data_dir() {
    find "$DATA_DIR" -mindepth 1 -delete
}

install_backup() {
    xtrabackup --move-back --target-dir="$workdir/staging" --datadir="$DATA_DIR" > "$workdir/move.log" 2>&1 \
        || { log "could not move $1 into $DATA_DIR: $(tail -n 3 "$workdir/move.log" | tr '\n' ' ')"; empty_data_dir; return 1; }
    rm -f "$DATA_DIR/auto.cnf" "$DATA_DIR/mysqld-auto.cnf"
}

restore() {
    log "downloading $1"
    s3_download "$1" "$workdir/archive" || { log "download of $1 failed"; return 1; }
    archive_is_valid "$1" "$workdir/archive" || return 1
    prepare_backup "$workdir/archive" "$1" || return 1
    rm -f "$workdir/archive"
    install_backup "$1" || return 1
    log "restored $1"
}

main() {
    validate_backup_env
    mysql_alive && fail "mysqld is running, stop it before restoring"
    data_dir_empty || fail "$DATA_DIR is not empty"

    backups=$(backup_names) || fail "cannot list backups in s3"
    if [ -z "$backups" ]; then
        log "WARNING: no backups under s3://$S3_BUCKET/$BACKUP_PATH/, starting empty"
        exit 2
    fi

    workdir=$(mktemp -d "$BACKUP_TMP_DIR/restore.XXXXXX")
    trap 'rm -rf "$workdir"' EXIT

    for name in $(printf '%s\n' "$backups" | newest_first); do
        restore "$name" && return 0
        log "falling back to the previous backup"
    done
    fail "no valid backup found under s3://$S3_BUCKET/$BACKUP_PATH/"
}

main
