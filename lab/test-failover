#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

IMAGE=${LAB_IMAGE:-mysql-cluster:dev}
NETWORK=mysql-lab_lab
SETTLE_SECONDS=10
PASSWORD=$(sed -n 's/^CLUSTER_ADMIN_PASSWORD=//p' node.env)

log() {
    printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >&2
}

member_sql() {
    docker compose exec -T "$1" sql -NBe "$2" </dev/null
}

primary_seen_by() {
    member_sql "$1" "SELECT MEMBER_HOST FROM performance_schema.replication_group_members WHERE MEMBER_ROLE = 'PRIMARY' AND MEMBER_STATE = 'ONLINE'" 2>/dev/null
}

service_at() {
    printf 'mysql-%s' "${1##*.}" | sed 's/mysql-1\([0-9]\)$/mysql-\1/'
}

router_host_except() {
    local host
    for host in 10.77.0.11 10.77.0.12 10.77.0.13; do
        [ "$host" = "$1" ] || { printf '%s' "$host"; return; }
    done
}

client() {
    docker run --rm -i --network "$NETWORK" --entrypoint mysql "$IMAGE" -u clusteradmin -p"$PASSWORD" --ssl-mode=REQUIRED "$@" 2>&1 | { grep -v Warning || true; }
}

start_writer() {
    docker rm -f lab-writer >/dev/null 2>&1 || true
    docker run -d --name lab-writer --network "$NETWORK" -e MYSQL_PWD="$PASSWORD" --entrypoint bash "$IMAGE" -c '
        i=0
        while [ ! -e /tmp/stop ]; do
            i=$((i + 1))
            if timeout 2 mysql -h "$0" -P 6446 -u clusteradmin --ssl-mode=REQUIRED -e "INSERT INTO labtest.writes VALUES ($i)" 2>/dev/null; then
                result=OK
            else
                result=ERR
            fi
            echo "$(date +%s%3N) $i $result" >> /tmp/log
            sleep 0.1
        done' "$1" >/dev/null
}

stop_writer() {
    docker exec lab-writer touch /tmp/stop
    docker wait lab-writer >/dev/null
    docker cp -q lab-writer:/tmp/log "$1"
    docker rm -f lab-writer >/dev/null
}

wait_for() {
    local description=$1 deadline=$((SECONDS + $2))
    shift 2
    log "waiting for $description"
    until "$@"; do
        [ "$SECONDS" -lt "$deadline" ] || { log "timed out waiting for $description"; exit 1; }
        sleep 1
    done
}

new_primary_elected() {
    local seen
    seen=$(primary_seen_by "$1")
    [ -n "$seen" ] && [ "$seen" != "$2" ]
}

online_again() {
    [ "$(member_sql "$1" "SELECT MEMBER_STATE FROM performance_schema.replication_group_members WHERE MEMBER_ID = @@server_uuid" 2>/dev/null)" = ONLINE ]
}

report() {
    awk -v stopped="$2" -v promoted="$3" -v list="$4" '
        BEGIN { while ((getline value < list) > 0) stored[value] = 1 }
        { attempts++ }
        $3 == "OK" { acked++; if (!($2 in stored)) lost++; if ($1 > stopped && errors && !recovered) recovered = $1 }
        $3 == "ERR" { errors++; if (!first_error) first_error = $1; last_error = $1 }
        END {
            printf "writes attempted:          %d\n", attempts
            printf "acknowledged:              %d\n", acked
            printf "failed:                    %d\n", errors
            if (errors) printf "error window:              %.1f s (first error %.1f s after kill, last %.1f s after kill)\n", (last_error - first_error) / 1000, (first_error - stopped) / 1000, (last_error - stopped) / 1000
            if (recovered) printf "writes recovered after:    %.1f s\n", (recovered - stopped) / 1000
            printf "new primary seen after:    %.1f s\n", (promoted - stopped) / 1000
            printf "acknowledged writes lost:  %d\n", lost + 0
        }
    ' "$1"
}

writer_clock() {
    docker exec lab-writer date +%s%3N
}

main() {
    local primary old_service survivor router stopped promoted
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    primary=$(primary_seen_by mysql-2)
    old_service=$(service_at "$primary")
    router=$(router_host_except "$primary")
    survivor=$(service_at "$router")
    log "primary is $primary ($old_service); writing through the router on $router"

    client -h "$router" -P 6446 -e 'DROP DATABASE IF EXISTS labtest; CREATE DATABASE labtest; CREATE TABLE labtest.writes (id INT PRIMARY KEY)'
    start_writer "$router"
    sleep 5
    log "docker kill $old_service (SIGKILL, no clean shutdown)"
    stopped=$(writer_clock)
    docker compose kill "$old_service" >/dev/null 2>&1
    wait_for "a new primary" 120 new_primary_elected "$survivor" "$primary"
    promoted=$(writer_clock)
    log "new primary: $(primary_seen_by "$survivor")"
    sleep "$SETTLE_SECONDS"
    stop_writer "$work/log"
    client -h "$router" -P 6446 -NBe 'SELECT id FROM labtest.writes' > "$work/stored"

    log "starting $old_service again"
    docker compose start "$old_service" >/dev/null 2>&1
    docker compose up -d --force-recreate --no-deps "router-${old_service#mysql-}" >/dev/null 2>&1
    wait_for "$old_service to rejoin as ONLINE" 300 online_again "$old_service"
    log "$old_service rejoined as $(member_sql "$old_service" "SELECT MEMBER_ROLE FROM performance_schema.replication_group_members WHERE MEMBER_ID = @@server_uuid")"
    printf 'rows on rejoined member:   %s\n' "$(member_sql "$old_service" 'SELECT COUNT(*) FROM labtest.writes')"

    report "$work/log" "$stopped" "$promoted" "$work/stored"
}

main
